// For format details, see https://aka.ms/devcontainer.json. 
{
  "name": "labs434",
  "context": "..",
  "dockerFile": "./Dockerfile",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-python.python",
        "samuelcolvin.jinjahtml",
        "ms-azuretools.vscode-containers",
        "julienblanchon.mujoco-viewer",
        "Gruntfuggly.todo-tree",
        "redhat.vscode-xml",
        "docker.docker"
      ]
    }
  },
  "runArgs": [
    "--gpus",
    "all"
  ],
  "containerEnv": {
    "DISPLAY": "${env:DISPLAY}",
    "XAUTHORITY": "/home/ubuntu/.Xauthority",
    "MUJOCO_GL": "egl"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=${localEnv:XAUTHORITY},target=/home/ubuntu/.Xauthority,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/ubuntu/.codex,type=bind"

  ],
  // Uncomment to connect as a non-root user if you've added one.
  "remoteUser": "ubuntu"
}
